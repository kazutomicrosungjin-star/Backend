# Copy this file to .env and fill in real values. Never commit .env itself.

DB_HOST=localhost
DB_PORT=3306
DB_USER=paycst_app
DB_PASSWORD=change_me
DB_NAME=paycst
# Set to true if the DB isn't on the same private network as this server
# (e.g. a managed/hosted MySQL reached over the public internet).
DB_SSL=false

# Generate a long random string for this, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

PORT=3000

# Comma-separated list of allowed browser origins, e.g.:
#   CORS_ORIGIN=https://app.paycst.com,https://paycst.com
# Leave unset to allow any origin (fine for mobile-only clients, since
# Flutter mobile doesn't send an Origin header; only relevant once a web
# build is deployed).
CORS_ORIGIN=

# Set to true ONCE on a brand-new empty database so the server creates its
# tables on startup (safe to leave on; it only adds what is missing).
AUTO_SETUP_DB=

# Face++ keys (face matching + one-face-per-account check)
FACEPP_API_KEY=
FACEPP_API_SECRET=

# Face++ FaceSet that holds the registered face tokens. Must match on both the
# server and clear-faces.js, or clear-faces.js will empty a different set.
# Default when unset: paycst_users
FACESET_OUTER_ID=

# Face++ similarity score (0-100) at or above which a new selfie is treated as
# "already registered" by someone else's account. Higher = stricter.
# Default when unset: 80
FACE_DUPLICATE_THRESHOLD=

# 64 hex characters. Encrypts ID photos waiting for review.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHOTO_ENCRYPTION_KEY=

# Keep the ID/selfie photos after an admin decision instead of deleting them.
# Only ever set this to true; anything else (including unset) means delete.
# Default when unset: false (photos are deleted once decided)
KEEP_ID_PHOTOS=

# Phone verification codes (sign-up). With NO provider set, codes are only printed
# in the server log. Set OTP_DEV_MODE=true to also send the code back to the app
# (demo only; ignored once SEMAPHORE_API_KEY is set).
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
OTP_DEV_MODE=
# Maximum phone-verification SMS sent across all numbers per hour. Default: 100
SMS_MAX_SENDS_PER_HOUR=
# Set to false to skip the phone check (not recommended)
REQUIRE_PHONE_OTP=

# Live movies in the Store (free key from themoviedb.org/settings/api, "API Key (v3 auth)").
# Without it the app shows its built-in sample movies.
TMDB_API_KEY=
MOVIES_REGION=PH

# Wallet limits in pesos (demo values) and the simulated cash-in confirmation button.
LIMIT_PER_TRANSACTION_PESOS=50000
LIMIT_DAILY_PESOS=100000
LIMIT_MAX_BALANCE_PESOS=500000
# Fully verified limits in pesos. Unset values fall back to the matching LIMIT_*
# value above; set all three to activate higher limits.
FULLY_VERIFIED_LIMIT_PER_TRANSACTION_PESOS=50000
FULLY_VERIFIED_LIMIT_DAILY_PESOS=100000
FULLY_VERIFIED_LIMIT_MAX_BALANCE_PESOS=500000
# Limits for new 'basic' accounts, in pesos. Defaults when unset:
# 2000 per transaction, 5000 per day, 10000 maximum balance.
BASIC_LIMIT_PER_TRANSACTION_PESOS=2000
BASIC_LIMIT_DAILY_PESOS=5000
BASIC_LIMIT_MAX_BALANCE_PESOS=10000
# Set to true for local demos only: it unhides the 'simulate payment' button that
# lets a logged-in user credit themselves. Default when unset: false (an admin
# confirms the cash in instead). Only the exact string 'true' turns it on.
DEMO_MODE=false
